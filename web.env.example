WEB_SECRET_KEY=generate-a-separate-web-secret
WEB_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
WEB_DEMO=0
WEB_DEBUG=0
WEB_SECURE_COOKIES=0
WEB_REQUIRE_HTTPS=0
WEB_TRUST_PROXY=0
WEB_ANALYTICS_DB_HOST=127.0.0.1
WEB_ANALYTICS_DB_PORT=5432
WEB_ANALYTICS_DB_NAME=bus_analytics
WEB_ANALYTICS_DB_USER=bus_dashboard
WEB_ANALYTICS_DB_PASS=generate-a-readonly-database-password
WEB_TIMEZONE=Europe/Saratov
# Private video storage: GiB limits, incomplete uploads reserve their remaining size.
WEB_UPLOAD_MAX_GB=20
WEB_UPLOAD_QUOTA_GB=40
WEB_UPLOAD_MIN_FREE_GB=2
WEB_UPLOAD_MAX_ACTIVE=3
# Local runs: override with a private directory and ffprobe executable if needed.
# WEB_UPLOAD_DIR=D:/private-video-uploads
# WEB_FFPROBE=C:/ffmpeg/bin/ffprobe.exe
