DB_NAME=bus_analytics
DB_USER=bus_counter
# Replace before running Compose. No public PostgreSQL port is published.
DB_PASS=replace-with-a-long-random-password
BUS_ID=BUS_01
CAMERA_ID=CAM_DOOR_01
TIMEZONE=Europe/Saratov
VIDEO_SOURCE=/app/data/test.mp4
SOURCE_KIND=file
# Required for files: actual first-frame time with timezone, e.g. 2026-11-01T05:40:00+04:00.
# Leave empty for live streams/cameras.
VIDEO_START=
MODEL_PATH=/app/models/candidates/person_manual_v1.onnx
REID_MODEL_PATH=/app/models/person_reid.onnx
TRACKER_PATH=/app/botsort_reid.yaml
TRACKING_MODE=appearance
CONFIDENCE=0.35
TRACKER_IDENTITY_MIN_SIMILARITY=0.70
# Disabled for the generic camera; the explicit test2 profile enables its calibrated guard.
TRACKER_DRIFT_THRESHOLD=0.0
IMAGE_SIZE=640
CPU_THREADS=4
STAFF_MODE=disabled
# Experimental approximate preschool-child filter. Unknown passengers are counted.
CHILD_MODE=disabled
CHILD_MODEL_PATH=/app/models/candidates/child_filter_v1.json
CHILD_CONFIRM_SAMPLES=3
CHILD_DECISION_DELAY_SEC=10
# Later: set STAFF_MODE=model and specify the trained work-vest model.
VEST_MODEL_PATH=
STATE_PATH=/app/state/runtime.sqlite3
DEVICE=cpu
Y_STREET=0.38
Y_LINE=0.50
Y_CABIN=0.60
DOOR_X_MIN=0.04
DOOR_X_MAX=0.90
ANCHOR_Y=0.5
ENTER_FROM=street
REID_THRESHOLD=0.85
REID_MARGIN=0.06
DUPLICATE_INTERVAL_SEC=3600
VEST_THRESHOLD=0.90
STAFF_DECISION_DELAY_SEC=10
