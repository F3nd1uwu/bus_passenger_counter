DB_NAME=bus_analytics
DB_USER=bus_counter
DB_PASS=replace-with-a-long-random-password
BUS_ID=BUS_01
CAMERA_ID=CAM_DOOR_01
TIMEZONE=Europe/Saratov
# Supply a reachable camera URL. Do not commit credentials.
VIDEO_SOURCE=rtsp://camera.example.invalid/live
SOURCE_KIND=stream
VIDEO_START=
# Docker CMD applies --profile test2; its vision settings override environment.
MODEL_PATH=/app/models/candidates/person_test2_v2.onnx
REID_MODEL_PATH=/app/models/person_reid.onnx
VEST_MODEL_PATH=/app/models/candidates/work_vest_v3.onnx
TRACKER_PATH=/app/botsort_reid.yaml
TRACKING_MODE=appearance
STAFF_MODE=model
CHILD_MODE=disabled
CONFIDENCE=0.30
CPU_THREADS=4
IMAGE_SIZE=640
STATE_PATH=/app/state/runtime.sqlite3
DEVICE=cpu
Y_STREET=0.38
Y_LINE=0.50
Y_CABIN=0.57
DOOR_X_MIN=0.04
DOOR_X_MAX=0.90
ANCHOR_Y=0.5
ENTER_FROM=street
REID_THRESHOLD=0.85
REID_MARGIN=0.06
DUPLICATE_INTERVAL_SEC=3600
VEST_THRESHOLD=0.20
VEST_CONFIRM_FRAMES=2
STAFF_DECISION_DELAY_SEC=10
