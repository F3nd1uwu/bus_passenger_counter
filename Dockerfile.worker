ARG COUNTER_IMAGE=bus-passenger-counter:archive-base
FROM ${COUNTER_IMAGE}
USER root
COPY requirements-web.txt /app/requirements-web.txt
ARG INSTALL_OPENVINO=0
RUN pip install --no-cache-dir -r /app/requirements-web.txt \
    && if [ "$INSTALL_OPENVINO" = "1" ]; then pip install --no-cache-dir openvino==2026.4.1; fi
COPY --chown=counter:counter core /app/core
COPY --chown=counter:counter config /app/config
COPY --chown=counter:counter database /app/database
COPY --chown=counter:counter web /app/web
COPY --chown=counter:counter manage_web.py /app/manage_web.py
COPY --chown=counter:counter tools/__init__.py tools/archive_resources.py tools/archive_protocol.py tools/archive_worker.py tools/build_clock_map.py tools/review_clock_map.py /app/tools/
RUN mkdir -p /app/webstate /app/state /app/uploads && chown counter:counter /app/webstate /app/state /app/uploads
USER counter
CMD ["python", "manage_web.py", "run_archive_scheduler"]
